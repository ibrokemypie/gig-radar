# Live shows settings. Copy to .env and fill in. Empty means unset.
# Keys and passwords are not set here: type them on the page under Settings.

# --- Home: where shows count as near ---------------------------------------------
# Your home point, in decimal degrees (required).
HOME_LATITUDE=
HOME_LONGITUDE=
# How far from home a show may be, in km (default 150).
HOME_RADIUS_KM=150
# Your time zone, an IANA name such as Europe/London (required).
HOME_TIMEZONE=
# Your country, a two-letter code such as GB or AU (required).
HOME_COUNTRY=
# Your city's name, optional. Its words are ignored when telling venues apart, so
# "Forum London" and "The Forum" are one venue.
HOME_CITY=
# In Australia only: ACT, NSW, NT, QLD, SA, TAS, VIC or WA. Turns on Oztix,
# Moshtix, musick.com.au and the festival lineup pages for that state.
HOME_STATE=
# A JSON file of festival lineup pages to read instead of the built-in list.
# Each entry: {"festival": ..., "match": ..., "url": ..., "country": ..., "state": ...};
# a page is read only when its country and state (where given) are home's.
FESTIVALS_FILE=

# --- The page ----------------------------------------------------------------------
# The address you open the page at; links in emails and calendar events use it,
# and calendar event ids end in its host.
LIVE_SHOWS_URL=http://localhost:8080/
# A password for the page. Unset, anyone who can reach it can use it.
LIVE_SHOWS_PASSWORD=
# Where the database lives (default /data/live-shows.sqlite).
LIVE_SHOWS_DB=/data/live-shows.sqlite

# --- Listening: where your artists come from -----------------------------------------
# plex or lastfm (default plex).
LIBRARY=plex

# Plex: the server's address and a token (see the README).
PLEX_URL=http://plex:32400
PLEX_TOKEN=
# Instead of a token: the path to the server's Preferences.xml, mounted into the
# container; its owner token is read from it.
PLEX_PREFERENCES=
# Whose plays count: the Plex account id (default 1, the server's owner).
PLEX_ACCOUNT_ID=1
# The music library's section id. Unset, the first music library is used.
PLEX_MUSIC_SECTION=

# Last.fm: your username. The API key is typed on the page.
LASTFM_USER=

# --- Mail and calendars (each optional) ----------------------------------------------
# Your address. With MAIL_PROVIDER, it fills in every host below; without, it is
# the default sender, recipient and login.
MAIL_ADDRESS=
# fastmail fills SMTP_HOST, SMTP_PORT, IMAP_HOST and CALDAV_URL for you. Leave
# empty to set them yourself; anything set below wins over the preset.
MAIL_PROVIDER=

# Sending the emails. No SMTP_HOST, no emails.
SMTP_HOST=
# 587 for STARTTLS (default), 465 for TLS from the start.
SMTP_PORT=
# The login (default MAIL_ADDRESS, else MAIL_FROM).
SMTP_USER=
# Who the emails come from and go to (default MAIL_ADDRESS; MAIL_FROM defaults to MAIL_TO).
MAIL_FROM=
MAIL_TO=

# Reading ticket confirmations from your inbox. No IMAP_HOST, no reading.
IMAP_HOST=
# The login (default MAIL_ADDRESS).
IMAP_USER=

# Calendars over CalDAV. No CALDAV_URL, no calendars.
# Your calendar home's URL, such as https://dav.example.com/calendars/you/.
CALDAV_URL=
# The login (default MAIL_ADDRESS).
CALDAV_USER=
# The calendar this app makes and fills with loved shows (default "Live shows").
CALDAV_CALENDAR=
# The calendar for shows you have tickets for. Unset, your account's default
# calendar (read from the scheduling inbox, as Fastmail serves it).
CALDAV_TICKETS_CALENDAR=
